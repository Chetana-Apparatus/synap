# Backend API Configuration
# Update this URL to point to your actual backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Example for production:
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Public site CMS (blog + contact form)
# CMS_BASE_URL=https://cms-api.aspune.cloud
# CMS_API_KEY=
# CMS_WEBSITE_ID=
# CMS_MEDIA_BASE_URL=https://cms-media.aspune.cloud
# Optional: pin a specific contact form UUID (otherwise the first form named like "contact" is used)
# CMS_CONTACT_FORM_ID=
